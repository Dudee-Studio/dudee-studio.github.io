      "tempo": 1,
      "original_seconds": 5.507,
      "text": "Was fehlt? Abgehakt schlägt vor, was du wieder brauchen könntest."
    },
    {
      "segment": 1,
      "start": 7.06,
      "end": 8.94,
      "tempo": 1.0001,
      "original_seconds": 1.88,
      "text": "Dein eigener Rhythmus."
    },
    {
      "segment": 2,
      "start": 9.06,
      "end": 14.023,
      "tempo": 1,
      "original_seconds": 4.963,
      "text": "Heute Pasta? Gericht wählen. Zutaten auf die Liste!"
    },
    {
      "segment": 3,
      "start": 16.06,
      "end": 20.441,
      "tempo": 1,
      "original_seconds": 4.38,
      "text": "Im Laden einfach abhaken. Angebote und Coupons inklusive."
    },
    {
      "segment": 4,
      "start": 24.06,
      "end": 28.055,
      "tempo": 1,
      "original_seconds": 3.995,
      "text": "Mit Pro teilst du die Liste. Andere treten kostenlos bei."
    },
    {
      "segment": 5,
      "start": 30.06,
      "end": 32.94,
      "tempo": 1,
      "original_seconds": 2.88,
      "text": "Spontan entdeckt? Barcode scannen!"
    },
    {
      "segment": 6,
      "start": 34.56,
      "end": 36.491,
      "tempo": 1,
      "original_seconds": 1.931,
      "text": "Ausgaben genauer verstehen."
    },
    {
      "segment": 7,
      "start": 37.06,
      "end": 41.827,
      "tempo": 1,
      "original_seconds": 4.767,
      "text": "Pro: einmalig drei Euro neunundneunzig. Kein Abo."
    }
  ],
