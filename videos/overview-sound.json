  "speech": [
    {
      "segment": 0,
      "start": 0.3,
      "end": 4.634,
      "original_seconds": 4.334,
      "tempo": 1.0,
      "text": "Das ist Abgehakt. Deine App für einen entspannteren Einkauf."
    },
    {
      "segment": 1,
      "start": 5.1,
      "end": 10.86,
      "original_seconds": 5.76,
      "tempo": 1.0,
      "text": "Vor dem Einkaufen gehst du deine Artikel durch. Was fehlt, kommt mit einem Tipp auf die Liste."
    },
    {
      "segment": 2,
      "start": 12.1,
      "end": 18.896,
      "original_seconds": 7.397,
      "tempo": 1.0878,
      "text": "Und was kochen wir? Wähle eines deiner Gerichte und übernimm die Zutaten direkt auf deine Liste."
    },
    {
      "segment": 3,
      "start": 19.1,
      "end": 24.903,
      "original_seconds": 6.315,
      "tempo": 1.0888,
      "text": "Im Laden hast du alles dabei. Einfach einkaufen, abhaken und den Überblick behalten."
    },
    {
      "segment": 4,
      "start": 25.1,
      "end": 29.159,
      "original_seconds": 4.059,
      "tempo": 1.0,
      "text": "Ein gutes Angebot? Trage den Preis und den Zeitraum ein."
    },
    {
      "segment": 5,
      "start": 31.1,
      "end": 34.043,
      "original_seconds": 2.943,
      "tempo": 1.0,
      "text": "Coupons berücksichtigst du beim Bezahlen."
    },
    {
      "segment": 6,
      "start": 36.1,
      "end": 39.939,
      "original_seconds": 3.839,
      "tempo": 1.0,
      "text": "Dein letzter Angebotspreis. Mit Kaufdatum."
    },
    {
      "segment": 7,
      "start": 42.1,
      "end": 47.921,
      "original_seconds": 6.244,
      "tempo": 1.0765,
      "text": "Auch deine Einkäufe und Monatsausgaben hast du im Blick. Das alles ist kostenlos."
    },
    {
      "segment": 8,
      "start": 48.1,
      "end": 52.285,
      "original_seconds": 4.185,
      "tempo": 1.0,
      "text": "Du möchtest noch mehr? Dann gibt es Abgehakt Pro!"
    },
    {
      "segment": 9,
      "start": 53.1,
      "end": 61.889,
      "original_seconds": 8.839,
      "tempo": 1.0045,
      "text": "Teile deine Liste mit deiner Familie, Freunden oder deiner WG. Mit Pro lädst du ein. Die anderen machen kostenlos mit."
    },
    {
      "segment": 10,
      "start": 62.1,
      "end": 69.119,
      "original_seconds": 7.019,
      "tempo": 1.0,
      "text": "Spontan etwas entdeckt? Mit Pro scannst du den Barcode und ergänzt deinen Einkauf."
    },
    {
      "segment": 11,
      "start": 70.1,
      "end": 75.571,
      "original_seconds": 5.471,
      "tempo": 1.0,
      "text": "Auch vorhandene Artikel kannst du mit einem Barcode verknüpfen. Ganz ohne Foto."
    },
    {
      "segment": 12,
      "start": 76.1,
      "end": 80.808,
      "original_seconds": 4.708,
      "tempo": 1.0,
      "text": "Und mit den erweiterten Auswertungen verstehst du deine Ausgaben noch genauer."
    },
    {
      "segment": 13,
      "start": 82.1,
      "end": 89.902,
      "original_seconds": 8.33,
      "tempo": 1.0679,
      "text": "Pro: einmalig drei Euro neunundneunzig. Kein Abo. Einmal kaufen und gemeinsam einkaufen."
    }
  ],
